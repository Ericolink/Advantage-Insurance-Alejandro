# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local development. On Netlify, set these in
# Site configuration → Environment variables and redeploy after changing them.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Lead delivery: configure AT LEAST ONE destination ────────────────────────
# Without one, the contact form says it is not connected yet and offers the
# phone/email instead. It never pretends a request was sent.

# Option A: email notification through Resend (https://resend.com).
RESEND_API_KEY=
# Inbox that receives the requests (Alejandro's business email).
LEAD_EMAIL_TO=
# Verified sender on your domain, e.g. "Website <solicitudes@your-domain.com>".
LEAD_EMAIL_FROM=

# Option B: webhook (Zapier, Make, n8n, Google Apps Script, a CRM…).
# Each request is POSTed as JSON.
LEAD_WEBHOOK_URL=
# Optional shared secret, sent in the "X-Lead-Secret" header.
LEAD_WEBHOOK_SECRET=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). It only loads after the
# visitor accepts the analytics notice. No personal data is ever sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google Search Console (optional) ─────────────────────────────────────────
# Value of the "google-site-verification" meta tag (HTML tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Publishing modes ─────────────────────────────────────────────────────────
# 1 = review mode on a production build: shows "pending" markers and draft data
# so the client can review it. The site is never indexable in this mode.
NEXT_PUBLIC_SHOW_PENDING=
# 1 = `next build` FAILS while blocking launch items are pending (use at launch).
REQUIRE_LAUNCH_READY=
